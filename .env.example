TMDB_API_KEY=your_tmdb_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SITE_URL=https://occuinplay.occuin.com

# Direct video sources for the native player, keyed by "movie:<tmdbId>" or "tv:<tmdbId>:<season>:<episode>".
# Titles without an entry fall back to the third-party embed.
DIRECT_SOURCES={"movie:1234":"https://example.com/stream.m3u8"}
# Optional comma-separated host allowlist for the above (empty = any https host).
DIRECT_SOURCE_HOSTS=
# Set to false to never load third-party embeds (eliminates ad redirects).
# Titles without a DIRECT_SOURCES entry then show "No source available".
ALLOW_EMBED_FALLBACK=true
